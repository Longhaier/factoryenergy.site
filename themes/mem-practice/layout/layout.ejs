<!DOCTYPE html>
<html lang="<%= config.language %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= is_home() ? config.title : (page.title + ' | ' + config.title) %></title>
  <meta name="description" content="<%= page.description || config.description %>">
  <meta name="keywords" content="<%= page.keywords || config.keywords %>">
  <%- css('/css/style') %>
  <link rel="stylesheet" href="<%= url_for('/css/mem-practice.css') %>">
</head>
<body>
  <header id="mem-header">
    <nav class="mem-nav">
      <a href="<%= url_for('/') %>" class="mem-nav__brand">
        <span class="mem-nav__brand-icon">练</span>
        <%= config.title %>
      </a>
      <button class="mem-nav__toggle" id="nav-toggle" aria-label="菜单">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <ul class="mem-nav__menu" id="nav-menu">
        <% if (theme.menu) { %>
          <% for (const [label, link] of Object.entries(theme.menu)) { %>
            <li><a href="<%= url_for(link) %>"><%= label %></a></li>
          <% } %>
        <% } %>
      </ul>
    </nav>
  </header>

  <main id="mem-main">
    <%- body %>
  </main>

  <footer id="mem-footer">
    <div class="mem-footer__inner">
      <p>
        <span class="mem-footer__brand">
          <span class="mem-footer__brand-dot"></span>
          <%= theme.footer.copyright || config.author %>
        </span>
      </p>
      <p class="mem-footer__meta">&copy; <%= theme.footer.since || new Date().getFullYear() %> &middot; 由 <a href="https://hexo.io" target="_blank" rel="noopener">Hexo</a> 驱动</p>
    </div>
  </footer>

  <script>
    // Mobile nav toggle
    document.addEventListener('DOMContentLoaded', function() {
      var toggle = document.getElementById('nav-toggle');
      var menu = document.getElementById('nav-menu');
      if (toggle && menu) {
        toggle.addEventListener('click', function() {
          menu.classList.toggle('is-open');
          toggle.classList.toggle('is-active');
        });
      }

      // Highlight active nav item
      var currentPath = window.location.pathname;
      document.querySelectorAll('.mem-nav__menu a').forEach(function(link) {
        var href = link.getAttribute('href');
        if (href === currentPath || (href !== '/' && currentPath.indexOf(href) === 0)) {
          link.classList.add('is-active');
        }
      });
    });
  </script>
  <script src="<%= url_for('/js/mem-practice.js') %>"></script>
</body>
</html>
